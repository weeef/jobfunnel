{
  "manifest_version": 3,
  "name": "CareerFunnel - Job Tracker & Pipeline",
  "version": "1.0.0",
  "description": "Automatically track job applications, sync across devices, and visualize your hiring funnel from applied to offer or rejection.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "notifications",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.greenhouse.io/*",
        "*://boards.greenhouse.io/*",
        "*://jobs.lever.co/*",
        "*://*.myworkdayjobs.com/*",
        "*://jobs.ashbyhq.com/*",
        "*://*.joinhandshake.com/*"
      ],
      "js": [
        "shared/storage.js",
        "content/detector.js"
      ],
      "css": [
        "content/detector.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
